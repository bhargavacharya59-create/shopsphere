# Database
DATABASE_URL=postgresql://shopsphere_user:shopsphere_pass@localhost:5432/shopsphere_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Service Identity (for DevInsight AI)
SERVICE_NAME=shopsphere
SERVICE_VERSION=1.0.0

# Monitoring
ENABLE_METRICS=true
OTLP_ENDPOINT=http://localhost:4317

# Failure Simulation (NEVER enable in production)
ENABLE_FAILURE_SIMULATION=false
