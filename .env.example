# Must match INGEST_API_KEY in the DevInsight repository root .env.
# Generate once with: openssl rand -hex 32
INGEST_API_KEY=replace_with_one_shared_random_secret

# Optional local overrides
SECRET_KEY=replace_with_a_long_random_secret
OTLP_ENDPOINT=http://devinsight-otel:4317
ENABLE_FAILURE_SIMULATION=false
